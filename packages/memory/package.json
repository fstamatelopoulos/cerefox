{
  "name": "@cerefox/memory",
  "version": "1.2.0",
  "description": "Cerefox — user-owned shared memory for AI agents. CLI + stdio MCP server + web UI + ingestion for a knowledge base on your own Supabase project (or fully self-hosted with Cerefox Local).",
  "license": "Apache-2.0",
  "homepage": "https://github.com/fstamatelopoulos/cerefox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fstamatelopoulos/cerefox.git",
    "directory": "packages/memory"
  },
  "bugs": "https://github.com/fstamatelopoulos/cerefox/issues",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "anthropic",
    "claude",
    "agents",
    "knowledge-base",
    "supabase",
    "pgvector",
    "rag"
  ],
  "type": "module",
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0"
  },
  "bin": {
    "cerefox": "dist/bin/cerefox.js"
  },
  "files": [
    "dist",
    "docs",
    "AGENT_GUIDE.md",
    "AGENT_QUICK_REFERENCE.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.45.0",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "hono": "^4.12.34",
    "mammoth": "^1.9.0",
    "ora": "^9.4.0",
    "picocolors": "^1.0.0",
    "postgres": "^3.4.9",
    "prompts": "^2.4.2",
    "smol-toml": "^1.6.1",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "onnxruntime-node": "^1.21.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/cli-progress": "^3.11.5",
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "bun build src/bin/cerefox.ts --outdir dist/bin --target node --format esm --external @huggingface/transformers --external onnxruntime-node",
    "clean": "rm -rf dist docs AGENT_GUIDE.md AGENT_QUICK_REFERENCE.md",
    "bundle-docs": "bun run ../../scripts/bundle_package_docs.ts",
    "bundle-server-assets": "bun run ../../scripts/bundle_server_assets.ts",
    "build-frontend": "cd ../../frontend && bun install && bun run build",
    "bundle-frontend": "rm -rf dist/frontend && mkdir -p dist/frontend && cp -R ../../frontend/dist/. dist/frontend/",
    "prepublishOnly": "bun run clean && bun run bundle-server-assets && bun run bundle-docs && bun run build-frontend && bun run bundle-frontend && bun run build",
    "smoke": "node dist/bin/cerefox.js --help && node dist/bin/cerefox.js mcp --help"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
