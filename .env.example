# ── Cerefox configuration example ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
# Where this file lives — Cerefox resolves .env with this precedence (highest
# wins):
#
#   1. $CEREFOX_CONFIG_DIR  (explicit override; supports ~).
#   2. ./.env in the current working directory  (dev mode — for running from a
#      repo clone, e.g. `bun scripts/*.ts` or `cerefox` invoked inside the repo).
#   3. ~/.cerefox/.env  (user-state root — for installed setups where you don't
#      want a .env in the repo).
#
# Most contributors keep .env at the repo root (dev mode wins). Installed users
# typically place it at ~/.cerefox/.env. See docs/specs/polish-and-distribution-design.md
# §7 for the full rule.

# ── Supabase (required for web UI and CLI) ────────────────────────────────────
# See docs/guides/setup-supabase.md for screenshots and full walkthrough.
CEREFOX_SUPABASE_URL=https://your-project-ref.supabase.co

# CEREFOX_SUPABASE_KEY — the key used by the web app (`cerefox web`) and CLI to
# reach the Supabase Data API (PostgREST). Two formats both work:
#   - New "secret key" (recommended, starts with `sb_secret_`): Supabase Dashboard
#     → Project Settings → API Keys → Secret key.
#   - Legacy "service_role" JWT (starts with `eyJ...`): same panel, "Legacy" section.
# Keep this value secret — it bypasses Row Level Security.
CEREFOX_SUPABASE_KEY=sb_secret_...your-supabase-secret-key...

# CEREFOX_ACCESS_TOKEN — the Cerefox access token presented as a Bearer when
# calling the Edge Functions (GPT Actions, remote HTTP MCP, e2e tests, curl) and
# by `cerefox doctor`'s version check. A secret, rotatable credential
# (`cfx_pat_...`), NOT a Supabase key. Generate it with `cerefox token generate`,
# which mints it, sets the CEREFOX_ACCESS_TOKENS Function secret on Supabase, and
# writes this line for you — you don't set it by hand. The legacy anon JWT is no
# longer accepted by the Edge Functions (iter-28E; see docs/guides/migration-0.12.md).
# CEREFOX_ACCESS_TOKEN=cfx_pat_...

# ── Direct Postgres (required for schema deploy / migrations) ─────────────────
# Used by the schema-deploy path: `cerefox server deploy` (the in-process deploy)
# and the `bun scripts/{db_deploy,db_migrate,db_status}.ts` scripts. The web app
# and CLI's regular operations do NOT use this — they go through the Data API above.
#
# Use the **Session Pooler** (port 5432). The Transaction Pooler (port 6543)
# does NOT support DDL and will fail mid-schema during the schema deploy.
# The Direct Connection is IPv6-only on the free tier and unusable on most
# home/office networks.
#
# Finding the Session Pooler URI in 2026:
#   - The new Supabase "Connect" dialog often surfaces only the Direct Connection
#     and the Transaction Pooler. The Session Pooler may not be a first-class tab.
#   - Either: take the Transaction Pooler URI and change `:6543` → `:5432`.
#   - Or: open Project Settings → Database → Connection pooling.
#   - The username must include the project-ref suffix (`postgres.<project-ref>`).
#     Without the suffix you will get "Tenant or user not found".
#   - Append `?sslmode=require` to enforce TLS explicitly.
CEREFOX_DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-N-region.pooler.supabase.com:5432/postgres?sslmode=require

# ── Embeddings ────────────────────────────────────────────────────────────────
# OpenAI embeddings (the only embedder implemented in the TS runtime today).
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-openai-key...
# CEREFOX_OPENAI_BASE_URL=https://api.openai.com/v1   # safe to override (proxy/gateway)
#
# ⚠ Changing the MODEL or DIMENSIONS is a BREAKING change: query vectors must match the
#   stored vectors and the DB column is vector(768). After changing either you MUST
#   re-embed everything (`cerefox server reindex`); a non-768 model also needs a schema
#   change. Leave these unless you know you're re-indexing.
# CEREFOX_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# CEREFOX_OPENAI_EMBEDDING_DIMENSIONS=768

# Fireworks AI: documented for the Python runtime but NOT yet implemented in the TS
# runtime — CEREFOX_EMBEDDER / CEREFOX_FIREWORKS_* are currently no-ops. (Tracked for
# a future release.)
# CEREFOX_FIREWORKS_API_KEY=fw_...your-fireworks-key...

# ── Chunking ─────────────────────────────────────────────────────────────────
CEREFOX_MAX_CHUNK_CHARS=4000
CEREFOX_MIN_CHUNK_CHARS=100

# ── Retrieval ────────────────────────────────────────────────────────────────
CEREFOX_MAX_RESPONSE_BYTES=200000
# Minimum cosine similarity for hybrid/semantic results (0.0–1.0). Not applied to FTS.
# Single default used by the CLI (`--min-score`), MCP tools, and the web API.
# For OpenAI text-embedding-3-small: genuine matches start ~0.45.
# 0.50 = good default | 0.40 = wider recall | 0.70 = high precision
CEREFOX_MIN_SEARCH_SCORE=0.50

# ── Storage ──────────────────────────────────────────────────────────────────
# Default output dir for `cerefox backup` (override with -o). Default: ~/.cerefox/backups
# CEREFOX_BACKUP_DIR=~/.cerefox/backups

# ── Versioning ────────────────────────────────────────────────────────────────
# How long to retain archived document versions (hours). The most recent version
# is always kept regardless of this setting (accidental-deletion protection).
# CEREFOX_VERSION_RETENTION_HOURS=48
# Set to false to disable the retention sweep entirely (keep all archived versions).
# CEREFOX_VERSION_CLEANUP_ENABLED=true

# ── CLI caller identity (defaults for cerefox ingest / search / etc.) ────────
# These set the default value for the CLI's --author / --author-type / --requestor
# flags when the flag is not passed. Useful for agent harnesses that want to
# identify themselves once instead of on every invocation.
#
# Precedence: CLI flag > env var > built-in default ("unknown", "user", "user").
# `access_path` is always derived from the code layer ("cli") and not declarable.
#
# Human users: leave commented; pass --author / --requestor explicitly when
# desired. Agents: set CEREFOX_AUTHOR_TYPE=agent + CEREFOX_AUTHOR_NAME=<your-name>.
# See docs/guides/cli.md for full details.
# CEREFOX_AUTHOR_NAME=your-name-or-agent-name
# CEREFOX_AUTHOR_TYPE=user           # or "agent" for AI clients
# CEREFOX_REQUESTOR_NAME=your-name-or-agent-name

# ── Local / self-hosted (World B) ─────────────────────────────────────────────
# For the Docker backend (`install-local.sh` / `cerefox-local`), DON'T set the Supabase
# or database vars above — the container generates + owns them. Put OPENAI_API_KEY and
# any of the CEREFOX_* TUNING overrides above (min-search-score, chunking, version
# retention, embedding model/base-url, author identity) into ~/.cerefox/local/.env; they
# are forwarded into the container. Apply changes with `cerefox-local init`.
